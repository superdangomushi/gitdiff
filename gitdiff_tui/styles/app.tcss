Screen {
    layout: horizontal;
}

#sidebar {
    width: 30;
    min-width: 20;
    border-right: solid $primary-darken-2;
    background: $surface;
}

#sidebar-title {
    background: $primary;
    color: $text;
    padding: 0 1;
    height: 1;
    text-align: center;
}

#file-list {
    height: 1fr;
    padding: 0 1;
}

#diff-panel {
    width: 1fr;
}

#panel-splitter {
    width: 1;
    height: 1fr;
    background: $primary-darken-2;
}

#panel-splitter:hover, #panel-splitter.-dragging {
    background: $accent;
}

#diff-title {
    background: $secondary;
    color: $text;
    padding: 0 1;
    height: 1;
}

#diff-scroll {
    height: 1fr;
    overflow-y: auto;
    overflow-x: auto;
}

#diff-content {
    padding: 0 1;
    width: auto;
}

#comment-scroll {
    height: 1fr;
    overflow-y: auto;
    display: none;
}

#comment-content {
    padding: 0 1;
}

#editor-panel {
    width: 1fr;
}

#editor-title {
    background: $accent;
    color: $text;
    padding: 0 1;
    height: 1;
}

#editor-view-scroll {
    height: 1fr;
    overflow-y: auto;
    overflow-x: auto;
}

#editor-view {
    padding: 0 1;
    width: auto;
}

#editor {
    height: 1fr;
    display: none;
}
